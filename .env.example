# ==============================================
# ANZU - Yu-Gi-Oh! Card Inventory Backend
# Copy this file to .env and fill in the values
# ==============================================

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"

# App
NODE_ENV=development
PORT=3000

# JWT — use strong random secrets in production (min 32 chars)
JWT_SECRET=change_this_secret_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Frontend (for CORS)
FRONTEND_URL=http://localhost:3001

# YGOProDeck API (public, no auth required)
YGOPRODECK_API_URL=https://db.ygoprodeck.com/api/v7/cardinfo.php
